{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx", "strict": true,
    "types": ["node", "vite/client"], "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "server", "api", "scripts", "tests", "vite.config.ts", "playwright.config.ts"]
}
