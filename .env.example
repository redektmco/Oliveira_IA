# Públicas: Supabase Project Settings > API. Nunca use service_role em VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Exclusivamente servidor (Vercel Environment Variables / .env.local).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Alternativa aceita quando você usa esse nome no catálogo/Vercel:
AI_SECRET_CLAUDE=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_DAILY_REQUEST_LIMIT=50

# Evolution: conexão, webhook e fila de envio (somente servidor).
WHATSAPP_EVO_URL=
WHATSAPP_EVO_INSTANCE=
WHATSAPP_EVO_TOKEN=
# Alias aceito para a chave já cadastrada com este nome na Vercel:
WHATSAPP_TOKEN_EVO=

# Somente para automação administrativa no ambiente de desenvolvimento:
# SUPABASE_ACCESS_TOKEN vem do vínculo seguro; não é necessário na Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=sa-east-1

# Segredos aleatórios distintos, privados/Sensitive. Worker também no Supabase Vault.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WORKER_SECRET=
WHATSAPP_OWNER_USER_ID=
