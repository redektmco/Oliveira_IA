# Públicas: Supabase Project Settings > API. Nunca use service_role em VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Exclusivamente servidor (Vercel Environment Variables / .env.local).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Alternativa aceita quando você usa esse nome no catálogo/Vercel:
AI_SECRET_CLAUDE=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_REQUEST_LIMIT=50
# Limite do chat de IA (Assistente e Playground), por pessoa, em US$ equivalentes. SDR IA não tem limite.
AI_CHAT_WINDOW_USD=0.1
AI_CHAT_DAILY_USD=0.3
# E-mails da equipe da agência (painel Clientes da agência), separados por vírgula.
PLATFORM_ADMIN_EMAILS=

# Evolution: conexão, webhook e fila de envio (somente servidor).
WHATSAPP_EVO_URL=
WHATSAPP_EVO_INSTANCE=
WHATSAPP_EVO_TOKEN=
# Alias aceito para a chave já cadastrada com este nome na Vercel:
WHATSAPP_TOKEN_EVO=

# Somente para automação administrativa no ambiente de desenvolvimento:
# SUPABASE_ACCESS_TOKEN vem do vínculo seguro; não é necessário na Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=sa-east-1

# Segredos aleatórios distintos, privados/Sensitive. Worker também no Supabase Vault.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WORKER_SECRET=
WHATSAPP_OWNER_USER_ID=

# Configurações de workspace e integrações. Todas as chaves abaixo são exclusivas do servidor.
APP_ORIGIN=https://ai.v4oliveira.com.br
# Gere 32 bytes aleatórios, codificados em 64 caracteres hexadecimais, e mantenha a chave estável.
INTEGRATION_ENCRYPTION_KEY=
# OAuth Google: URI de redirecionamento APP_ORIGIN/api/oauth?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta: callback OAuth APP_ORIGIN/api/oauth?provider=instagram
# Webhook APP_ORIGIN/api/provider-webhook?provider=instagram
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
# Stripe: preços recorrentes e webhook APP_ORIGIN/api/provider-webhook?provider=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_GROWTH=
