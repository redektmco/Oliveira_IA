{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/whatsapp-status.ts": {
      "maxDuration": 30
    },
    "api/whatsapp-webhook.ts": {
      "maxDuration": 60
    },
    "api/whatsapp-worker.ts": {
      "maxDuration": 60
    },
    "api/whatsapp-admin.ts": {
      "maxDuration": 60
    },
    "api/whatsapp-send.ts": {
      "maxDuration": 60
    },
    "api/workspace.ts": {
      "maxDuration": 60
    },
    "api/oauth.ts": {
      "maxDuration": 60
    },
    "api/public.ts": {
      "maxDuration": 60
    },
    "api/provider-webhook.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon.svg|widget\\.(?:html|js|css)|widget-client\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/((?!widget\\.html).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!widget\\.html|api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/widget.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors https:; form-action 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
