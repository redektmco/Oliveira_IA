{
  "name": "oliveira-ia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "cloud:check": "node --use-env-proxy --import tsx scripts/setup-cloud.ts --check",
    "cloud:apply": "node --use-env-proxy --import tsx scripts/setup-cloud.ts --apply",
    "cloud:smoke": "node --use-env-proxy --import tsx scripts/live-smoke.ts",
    "deploy:preview": "vercel",
    "deploy:production": "vercel --prod",
    "crm:check": "node --use-env-proxy --import tsx scripts/migrate-crm.ts --check",
    "crm:migrate": "node --use-env-proxy --import tsx scripts/migrate-crm.ts --apply",
    "opportunities:check": "node --use-env-proxy --import tsx scripts/migrate-opportunities.ts --check",
    "opportunities:migrate": "node --use-env-proxy --import tsx scripts/migrate-opportunities.ts --apply",
    "workflows:check": "node --use-env-proxy --import tsx scripts/migrate-workflows.ts --check",
    "workflows:migrate": "node --use-env-proxy --import tsx scripts/migrate-workflows.ts --apply"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.99.0",
    "@vercel/functions": "^3.10.5",
    "lenis": "^1.3.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.6.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vercel": "^64.7.0",
    "vite": "^8.0.5"
  }
}
